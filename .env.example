# Postgres connection string (added automatically by the Neon integration on Vercel)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Used ONCE, on first start, to create the first admin account (username below, default "admin").
# After that, manage users from the "المستخدمون" tab.
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
# Set to false to close self-registration (new sign-ups are always "pending" until an admin approves them)
ALLOW_SIGNUP=true
# Random secret used to sign login cookies: openssl rand -hex 32
SESSION_SECRET=
